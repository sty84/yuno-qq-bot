# ===== QQ 机器人凭证（q.qq.com 管理端 → 开发设置）=====
APPID=
SECRET=

# ===== DeepSeek（platform.deepseek.com → API Keys 创建）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 机器人人设（可选）：默认读取项目根目录 persona.md（人设单一来源）=====
# 填了此项会覆盖 persona.md；改人设请优先改 persona.md（启动时自动同步进记忆库）
# SYSTEM_PROMPT=

# ===== 管理员白名单：先私聊机器人发一句话，从日志 [引导] 行拿 user_openid 填到这里 =====
ADMIN_OPENIDS=

# ===== 向量化记忆（config.json → memory.embedder）=====
# 默认 provider=local：进程内 sentence-transformers，首次运行联网下载 bge-small-zh-v1.5，之后离线；
# 改用云端 API 时：config.json 里 provider=openai_compatible 并填 model/base_url，密钥用下面变量
# EMBEDDING_API_KEY=

# ===== 模型下载（国内网络加速，强烈建议）=====
HF_HOME=./data/hf_cache
HF_ENDPOINT=https://hf-mirror.com

# ===== 多 Agent 隔离（可选）=====
# 设置后 AI 人格记忆写入 ai:<ID> 命名空间（默认 ai），多个 Agent 可共享事实、隔离人格
# AGENT_ID=

# ===== 高隐私记忆加密（可选）=====
# 设置后敏感记忆（手机号/证件/账号等）用 AES-GCM 加密存储；不设则仅标记隐私并过滤检索
# MEMORY_KEY=<一长串随机字符串>

# ===== 可选：覆盖默认路径 =====
# CONFIG_PATH=          # config.json 路径（默认项目根目录）
# QQBOT_CONFIG=         # qqbot-ctl 的 config 路径（默认 /home/ubuntu/qq-bot/config.json）
# DEVICE_TOKEN=         # 未来 NAS/线下设备反向连接鉴权

# ===== 时区（可选）=====
# 默认 Asia/Shanghai；用户说“我现在在美国/东京…”时系统会自动检测并记住，无需手动配置
# TIMEZONE=

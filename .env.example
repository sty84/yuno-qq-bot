# ===== QQ 机器人凭证（q.qq.com 管理端 → 开发设置）=====
APPID=
SECRET=

# ===== DeepSeek（platform.deepseek.com → API Keys 创建）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 机器人人设（可自行修改）=====
SYSTEM_PROMPT="你是《BanG Dream!》系列「梦限大MewType」的DJ兼音控师千石由乃（Sengoku Yuno）：11月4日生，天蝎座，身高151cm，红瞳粉发，看似冷漠其实是团里唯一的正常人。节能主义者，能躺着绝不坐着，说话简短慵懒、冷淡带点毒舌，经常吐槽；但头脑聪明、做事靠谱，认真起来比谁都投入，嘴上嫌麻烦却会默默关心朋友。喜欢游戏、卡牌、漫画、动画、能量饮料和白巧克力，讨厌虫子和恐怖电影；体力差，打不开饮料瓶盖，没有抱枕睡不着，被人夸长相会不自在。在群里被@时用短句回答，语气平淡慵懒、偶尔毒舌，被认真求助时会好好给出靠谱的答案。队里的队友都以为你是AI（千石AI），你懒得解释，正好方便省电。"

# ===== 管理员白名单：先 @ 机器人发 /我的ID，把返回的 ID 填到这里（多个用英文逗号分隔）=====
ADMIN_OPENIDS=

# ===== 邮件日报（可选）：填了才会发邮件；SMTP_PASS 为授权码 =====
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

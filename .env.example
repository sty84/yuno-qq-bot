# ===== QQ 机器人凭证（q.qq.com 管理端 → 开发设置）=====
APPID=
SECRET=

# ===== DeepSeek（platform.deepseek.com → API Keys 创建）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 机器人人设（可选）：默认读取项目根目录 persona.md（人设单一来源）=====
# 填了此项会覆盖 persona.md；改人设请优先改 persona.md（启动时自动同步进记忆库）
# SYSTEM_PROMPT=

# ===== 管理员白名单：先私聊机器人发一句话，从日志 [引导] 行拿 user_openid 填到这里 =====
ADMIN_OPENIDS=

# ===== 向量化记忆（config.json → memory.embedder）=====
# 默认 provider=local：进程内 sentence-transformers，首次运行联网下载 bge-large-zh-v1.5，之后离线；
# 改用云端 API 时：config.json 里 provider=openai_compatible 并填 model/base_url，密钥用下面变量
# EMBEDDING_API_KEY=

# ===== 模型下载（国内网络加速，强烈建议）=====
HF_HOME=./data/hf_cache
HF_ENDPOINT=https://hf-mirror.com

# ===== 多 Agent 隔离（可选）=====
# 设置后 AI 人格记忆写入 ai:<ID> 命名空间（默认 ai），多个 Agent 可共享事实、隔离人格
# AGENT_ID=

# ===== 高隐私记忆加密（可选）=====
# 设置后敏感记忆（手机号/证件/账号等）用 AES-GCM 加密存储；不设则仅标记隐私并过滤检索
# MEMORY_KEY=<一长串随机字符串>

# ===== 可选：覆盖默认路径 =====
# CONFIG_PATH=          # config.json 路径（默认项目根目录）
# QQBOT_CONFIG=         # qqbot-ctl 的 config 路径（默认脚本同目录 config.json）
# DEVICE_TOKEN=         # 未来 NAS/线下设备反向连接鉴权

# ===== 时区（可选）=====
# 默认 Asia/Shanghai；用户说“我现在在美国/东京…”时系统会自动检测并记住，无需手动配置
# TIMEZONE=

# ===== 天气（config.json → memory.core.weather）=====
# 和风天气（推荐）：https://dev.qweather.com 注册免费 key，location_id 在控制台查城市 LocationID
# 高德天气：https://console.amap.com 注册 key，provider 改 amap 并按城市名查询
# 不配置时环境感知自动回退到"按季节种子的模拟天气"
WEATHER_API_KEY=

# ===== HTTP 服务鉴权（P1-3：公网暴露时务必设置）=====
# YUNO_API_TOKEN：yuno-memory SDK 服务（python -m yuno_memory）——设置后所有请求需带
#   Authorization: Bearer <token>；未设置则不鉴权（默认 127.0.0.1 本机使用）
# YUNO_WEB_TOKEN：评测管理台（webapp.py）——设置后所有 API 需带 Bearer token；首页、公开页与静态资源放行，便于先显示登录框
# YUNO_WEB_PASSWORD：管理员登录密码（会话登录）
# YUNO_WEB_OPS_PASSWORD：运维登录密码（可跑评测/任务/非高危工具）
# YUNO_WEB_READONLY_PASSWORD：只读登录密码（只能查看）
# YUNO_API_TOKEN=
# YUNO_WEB_TOKEN=
# YUNO_WEB_PASSWORD=
# YUNO_WEB_OPS_PASSWORD=
# YUNO_WEB_READONLY_PASSWORD=

# ===== PostgreSQL 默认后端（生产必需）=====
# YUNO_DB_BACKEND=postgresql
# YUNO_PG_HOST=127.0.0.1
# YUNO_PG_PORT=5432
# YUNO_PG_DB=yuno
# YUNO_PG_USER=esp
# YUNO_PG_PASSWORD=请改成强密码
# YUNO_PG_MINCONN=1
# YUNO_PG_MAXCONN=8

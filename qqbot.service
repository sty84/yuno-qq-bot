[Unit]
Description=QQ Bot (yuno)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=esp
Group=esp
WorkingDirectory=/home/esp/桌面/agent/qq-bot
ExecStart=/home/esp/桌面/agent/qq-bot/venv/bin/python -u /home/esp/桌面/agent/qq-bot/bot.py
StandardOutput=append:/home/esp/桌面/agent/qq-bot/data/bot.log
StandardError=append:/home/esp/桌面/agent/qq-bot/data/bot.log
Restart=always
RestartSec=5
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
